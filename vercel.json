{
    "installCommand": "npm ci",
    "buildCommand": "npm run build -w client",
    "outputDirectory": "client/dist",
    "rewrites": [
      { "source": "/api/:path*", "destination": "https://collab-table.onrender.com/api/:path*" },
      { "source": "/(.*)", "destination": "/index.html" }
    ]
  }